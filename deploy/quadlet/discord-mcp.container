# systemd-podman Quadlet for the Discord MCP bridge (barryyip0625/mcp-discord).
# Backs the seeded *global* Discord connector: a Discord bot authenticates with
# a single bot token for the whole server/guild, not a per-user OAuth account,
# so there's no "each user connects their own Discord account" flow the way
# there is for Slack/GitHub/Atlassian. One bot, shared by everyone the gateway's
# RBAC grants the tool to — see deploy/README.md.
#
# The project publishes a ready HTTP image (streamable HTTP on :8080), so no
# local build is needed. (Not the `mcp/mcp-discord` verified image — that one
# is stdio-only, for the Docker MCP gateway, and unreachable over HTTP.)
#
# Install:
#   sudo cp deploy/quadlet/discord-mcp.container /etc/containers/systemd/
#   sudo install -m 0600 deploy/quadlet/discord-mcp.example.env \
#        /etc/gateway/discord-mcp.env
#   sudo $EDITOR /etc/gateway/discord-mcp.env          # set DISCORD_TOKEN
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now discord-mcp.service
#
# Then, as a gateway admin, open /admin/connectors, enable Discord, and set its
# URL to http://127.0.0.1:3334/mcp (the loopback port published below). No
# credential is configured on the connector — the bot token is baked into this
# container, and the endpoint is loopback-only / internal, never exposed
# publicly.

[Unit]
Description=Discord MCP bridge (shared bot, global gateway connector)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=discord-mcp
Image=docker.io/barryy625/mcp-discord:latest

# Loopback only — internal service, reached by the gateway. Never expose it
# publicly (the bot token grants full bot access, not scoped per caller).
PublishPort=127.0.0.1:3334:8080

EnvironmentFile=/etc/gateway/discord-mcp.env

# The image's default CMD already runs `node build/app.js --transport http
# --port 8080` — do not override Exec=.

NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target default.target
