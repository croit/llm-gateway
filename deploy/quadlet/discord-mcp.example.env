# Config for the Discord MCP bridge (SaseQ/discord-mcp).
# Install to /etc/gateway/discord-mcp.env. Referenced via EnvironmentFile=.
# This IS a secret: the bot token authenticates as your Discord bot for the
# whole gateway (there's no per-user Discord identity — see deploy/README.md).

# From the Discord Developer Portal → your application → Bot → Reset Token.
DISCORD_TOKEN=

# Optional: a default server (guild) id the bot uses when a tool call omits one.
# DISCORD_GUILD_ID=
