# Copy to /etc/gateway/gateway.env and fill in. The Quadlet's
# `EnvironmentFile=` pulls everything in this file into the container's env.
# Permissions: chmod 0600 + chown root:root, since this holds long-lived
# secrets.

# THE ONE REQUIRED VARIABLE. 32 random bytes hex-encoded; the gateway refuses
# to boot without it. Generate once:
#   openssl rand -hex 32
#
# It signs browser sessions AND derives the key that seals every secret stored
# in the database (backend API keys, connector client secrets, per-user OAuth
# tokens). Changing or losing it logs everyone out and makes all of those
# permanently unreadable — treat it as precious as the database itself and back
# the two up together.
GATEWAY_SESSION_KEY=__replace_me__

# Everything below is OPTIONAL.

# Separate the at-rest encryption key from the session key, so the session key
# can be rotated without destroying stored secrets. Unset, it is derived from
# GATEWAY_SESSION_KEY. Also 64 hex chars.
# GATEWAY_ENCRYPTION_KEY=

# The OIDC provider (issuer, client id, client secret) is configured in the
# setup wizard and stored encrypted in the database — it is NOT an env var any
# more. GATEWAY_OIDC_CLIENT_SECRET is still read for deployments that pin it
# via `[oidc].client_secret_env` in a legacy config.toml.

# Backend API keys are entered at /admin/upstreams and stored encrypted in the
# database. `<POOL>_API_KEY`-style variables are only read by deployments that
# still declare `api_key_env = "FOO"` in a legacy config.toml.

# Break-glass admin: OIDC claim values that ALWAYS resolve to admin, whatever
# the database says. Comma-separated. Setting it here rather than in a config
# file is the point — it is the escape hatch for a broken group mapping, so it
# belongs with the other break-glass material and not inside the thing it
# rescues you from. Unioned with any list in a config file, never replacing it.
# GATEWAY_BOOTSTRAP_ADMIN_GROUPS=platform-admins

# Where the SQLite database lives. Only needed to override the path derived from
# GATEWAY_DATA_DIR (which the image already sets to the mounted volume). Setting
# this AND `[db].path` in a config file to different paths aborts the boot rather
# than guessing — opening the wrong database looks like a fresh install.
# GATEWAY_DB_PATH=/var/lib/gateway/gateway.sqlite
