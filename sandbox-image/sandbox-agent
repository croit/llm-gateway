# In-image job marshaller for the LLM-gateway sandbox.
#
# The `sandbox-runner` service pipes a RunRequest (JSON) to this program's
# stdin via `podman exec -i <container> /usr/local/bin/sandbox-agent`, and
# reads a RunResponse (JSON) back on stdout. All file I/O, code execution,
# the inner timeout, and artifact collection happen here, inside the
# MicroVM — the runner stays a thin orchestrator.
#
# Contract (shared::sandbox):
#   in : {"language":"python"|"bash","code":str,
#         "files":[{"name":str,"content_b64":str}],
#         "timeout_secs":int|null,"network":bool}
#   out: {"exit_code":int,"stdout":str,"stderr":str,
#         "artifacts":[{"name":str,"size":int,"mime":str,"content_b64":str}],
#         "duration_ms":int,"timed_out":bool,"output_truncated":bool}

import base64
import json
import os
import shutil
import stat
import subprocess
import sys
import tempfile
import time

# `/work` in the container image; overridden to a temp dir by the runner's
# dev-only LocalBackend, which runs this agent directly on the host.
WORK = os.environ.get("SANDBOX_AGENT_WORK", "/work")
DEFAULT_TIMEOUT = 60
# Stdout/stderr are also clamped by the runner; this is a first-line guard
# so a runaway job can't OOM the agent building a giant string.
MAX_STREAM = 4 * 1024 * 1024
# Artifacts normally travel back inside the RunResponse as base64, and that is
# the only reason a cap exists here: the encoded string, the JSON wrapped around
# it and the runner's copy are all RAM. With host-backed scratch
# (SANDBOX_WORK_ROOT on the runner) the runner reads produced files off the bind
# mount itself, so it sets SANDBOX_ARTIFACTS_INPLACE=1 and this agent reports
# metadata only — no read, no base64, and no cap worth having, because the
# gateway's own max_artifact_bytes is then the limit that decides.
INPLACE_ARTIFACTS = os.environ.get("SANDBOX_ARTIFACTS_INPLACE") == "1"
MAX_ARTIFACT = int(os.environ.get("SANDBOX_MAX_ARTIFACT_BYTES", 64 * 1024 * 1024))
# `podman exec` stdout under gVisor (runsc) is hard-capped at 64 KiB — bytes
# past that are silently dropped, which would truncate a RunResponse carrying a
# sizeable artifact mid-JSON. So a response larger than this spills to a temp
# file; the runner reads it back in sub-cap chunks (see backend.rs
# `read_spill`). Smaller responses go inline on stdout as before — which also
# keeps the wire compatible with a runner that predates the spill protocol.
SPILL_THRESHOLD = 60 * 1024
# Above this, the full stream is also saved as a downloadable artifact, so the
# gateway can return a small preview + a `full_output_ref` (pointers-as-context)
# and the model reads the rest on demand. Kept modest so moderately-large output
# is addressable via a ref rather than inlined.
PRESERVE_THRESHOLD = 32 * 1024
# Directories the produced-file walk never descends into. `HOME` is set to the
# working directory (see the `subprocess.run` below) so anything wanting a
# profile or cache dir — LibreOffice, matplotlib, fontconfig, chromium, pip —
# drops one right next to the job's real output. A recursive walk without this
# would deliver hundreds of cache files as if the job had produced them. Every
# dot-directory is skipped for the same reason; this list is the few noisy names
# that don't start with one.
SKIP_DIRS = frozenset({"node_modules", "__pycache__", "site-packages", "venv"})
# Walk depth and file-count ceilings. A job that unpacks a source tree or a
# wheel would otherwise fan out into thousands of chat attachments; `.venv` and
# friends are already excluded above, so these bite only on genuinely huge
# output. Exceeding the count sets `artifacts_truncated` so the limit is stated
# rather than silent.
MAX_WALK_DEPTH = 8
MAX_ARTIFACTS = 64

MIME = {
    "pdf": "application/pdf",
    "png": "image/png",
    "jpg": "image/jpeg",
    "jpeg": "image/jpeg",
    "gif": "image/gif",
    "svg": "image/svg+xml",
    "webp": "image/webp",
    "txt": "text/plain",
    "md": "text/markdown",
    "csv": "text/csv",
    "json": "application/json",
    "html": "text/html",
    "xml": "application/xml",
    "zip": "application/zip",
    "mp4": "video/mp4",
    "mp3": "audio/mpeg",
    "wav": "audio/wav",
    "docx": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
    "xlsx": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    "pptx": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
}


def mime_for(name):
    ext = name.rsplit(".", 1)[-1].lower() if "." in name else ""
    return MIME.get(ext, "application/octet-stream")


def safe_name(name):
    """Reject path separators / traversal; a single path segment only."""
    return name and name not in (".", "..") and "/" not in name and "\\" not in name


def walk_files(workdir):
    """Every regular file under `workdir`, as `(relpath, abspath, stat)`.

    Recursive, and that recursion is the point. The tool tells the model to
    "write output files to the working directory to return them", so a model
    asked for a documentation set writes `docs/backend.md` — and a top-level
    `os.listdir` collected none of it. The run reported `exit_code: 0` with an
    empty `artifacts` list, which reads as "worked, produced nothing": the one
    shape a model cannot distinguish from its own mistake. It then either
    retries the same way or starts claiming files it never delivered.

    Symlinks are skipped rather than followed, at both the file and directory
    level (`os.walk(followlinks=False)` plus an `S_ISREG` check on `lstat`).
    Code in the sandbox is untrusted, so a link planted under a plausible
    output name must not smuggle a file out of the container's rootfs — and
    the runner's host-side read stays what it always was, a single-component
    `O_NOFOLLOW` open (see `read_sandbox_file`).

    Ordering is top-down and sorted, so top-level names are always seen before
    the subdirectory names that flatten onto them, which is what lets
    `flat_name` keep every pre-existing top-level name byte-identical."""
    for dirpath, dirnames, filenames in os.walk(workdir, followlinks=False):
        rel_dir = os.path.relpath(dirpath, workdir)
        at_root = rel_dir == "."
        depth = 0 if at_root else rel_dir.count(os.sep) + 1
        # Prune in place — os.walk reads `dirnames` back to decide where to go.
        dirnames[:] = (
            []
            if depth + 1 > MAX_WALK_DEPTH
            else [
                d
                for d in sorted(dirnames)
                if not d.startswith(".") and d not in SKIP_DIRS
            ]
        )
        for name in sorted(filenames):
            path = os.path.join(dirpath, name)
            try:
                st = os.lstat(path)
            except OSError:
                continue
            if not stat.S_ISREG(st.st_mode):
                continue  # symlink, fifo, socket, device — never an output
            yield (name if at_root else os.path.join(rel_dir, name)), path, st


def snapshot(workdir):
    """Map each regular file under `workdir` to a `(size, mtime_ns)` identity,
    keyed by path relative to `workdir`.

    Taken just before the job runs so artifact collection can return only the
    files THIS call created or changed. A sandbox container may be kept alive
    and reused across the calls of one conversation turn (see docs/sandbox.md),
    so `/work` is no longer guaranteed empty at start — without this, every
    earlier call's outputs (and a stale `stdout.txt`) would be re-collected and
    re-delivered on every subsequent call. On a fresh container the snapshot is
    just the staged inputs, so behaviour is identical to the old single-use
    model."""
    return {rel: (st.st_size, st.st_mtime_ns) for rel, _path, st in walk_files(workdir)}


def flat_name(rel, used):
    """The single-component name a produced file is delivered under.

    An artifact name becomes an attachment filename — the gateway stores it as
    the object key `<turn_id>/<name>` and the runner opens it back out of the
    scratch dir by plain name — so it cannot contain a separator. A file
    produced at `docs/backend.md` is therefore delivered as `docs-backend.md`.

    A top-level file keeps its name unchanged, and top-level names are
    registered first (see `walk_files` ordering), so introducing recursion
    cannot rename anything that already worked: a flattened `docs/backend.md`
    yields to an existing `docs-backend.md` and takes `docs-backend-2.md`."""
    base = rel.replace(os.sep, "-").replace("/", "-")
    if base not in used:
        used.add(base)
        return base
    stem, dot, ext = base.rpartition(".")
    if not dot:
        stem, ext = base, ""
    n = 2
    while True:
        candidate = f"{stem}-{n}.{ext}" if ext else f"{stem}-{n}"
        if candidate not in used:
            used.add(candidate)
            return candidate
        n += 1


def link_flat(src, name):
    """Give the runner a top-level plain name for a file produced in a
    subdirectory, without moving the file.

    With host-backed scratch the runner reads produced bytes off the bind mount
    by single-component name, deliberately: an intermediate directory could be
    a symlink, and `O_NOFOLLOW` only protects the final component. So instead
    of teaching that read to walk subpaths, we hand it something it already
    accepts — a hard link at the root pointing at the same inode. The original
    stays exactly where the job put it, so a later call in the same turn still
    finds its own `docs/backend.md`.

    The job process has already exited by the time this runs, so `src` cannot
    be swapped between the `S_ISREG` check in `walk_files` and the link.
    Returns False if neither the link nor a copy fallback works, in which case
    the caller drops the file rather than reporting a name that won't read."""
    dst = os.path.join(WORK, name)
    try:
        if os.path.lexists(dst):
            os.remove(dst)
        os.link(src, dst)
        return True
    except OSError:
        pass
    try:
        shutil.copyfile(src, dst)
        return True
    except OSError:
        return False


def emit(resp):
    """Return a RunResponse to the runner. Small payloads go inline on stdout;
    larger ones spill to a temp file (named in a tiny stdout header) because
    gVisor truncates `podman exec` stdout at 64 KiB. mkstemp gives a unique
    path so concurrent jobs sharing /tmp (the dev local backend) never clash."""
    data = json.dumps(resp).encode("utf-8")
    if len(data) <= SPILL_THRESHOLD:
        sys.stdout.buffer.write(data)
        return
    fd, path = tempfile.mkstemp(prefix="sandbox-response-", suffix=".json")
    with os.fdopen(fd, "wb") as fh:
        fh.write(data)
    sys.stdout.buffer.write(
        json.dumps(
            {"sandbox_response_file": path, "sandbox_response_bytes": len(data)}
        ).encode("utf-8")
    )


def fail(msg, code=2):
    emit(
        {
            "exit_code": code,
            "stdout": "",
            "stderr": msg,
            "artifacts": [],
            "duration_ms": 0,
            "timed_out": False,
            "output_truncated": False,
        }
    )
    sys.exit(0)


def main():
    try:
        req = json.load(sys.stdin)
    except Exception as e:  # noqa: BLE001
        # Intentionally broad: any malformed stdin (bad JSON, wrong type, empty
        # pipe, decode error) should exit with one clean "bad request" message
        # rather than a traceback. fail() exits, so nothing leaks past here.
        fail(f"sandbox-agent: bad request json: {e}")

    language = req.get("language")
    code = req.get("code", "")
    files = req.get("files") or []
    timeout = req.get("timeout_secs") or DEFAULT_TIMEOUT

    os.makedirs(WORK, exist_ok=True)
    # Materialize input files and remember them so they're not mistaken for
    # produced artifacts.
    inputs = set()
    for f in files:
        name = f.get("name", "")
        if not safe_name(name):
            fail(f"sandbox-agent: unsafe input filename {name!r}")
        try:
            # validate=False: the encoder is our own gateway, and it may wrap
            # long payloads with newlines. Discarding non-alphabet chars matches
            # what the gateway emits; this is not a trust boundary (the sandbox
            # is), so strict validation would only reject legitimate input.
            data = base64.b64decode(f.get("content_b64", ""), validate=False)
        except Exception as e:  # noqa: BLE001
            # Broad on purpose: any decode failure becomes one clean error via
            # fail() (which exits) instead of a traceback.
            fail(f"sandbox-agent: bad base64 for {name!r}: {e}")
        with open(os.path.join(WORK, name), "wb") as fh:
            fh.write(data)
        inputs.add(name)

    # Snapshot /work AFTER staging inputs but BEFORE running the job, so we can
    # later collect only what this call produced. On a reused container this
    # excludes leftovers from earlier calls in the turn; on a fresh one it's
    # just the inputs (so nothing changes for the single-use path).
    baseline = snapshot(WORK)

    # Build the command. The script body goes to a UNIQUE temp file (not a
    # fixed path) so concurrent jobs that share a /tmp — e.g. the dev
    # local-unsafe backend — never clobber each other's code; and it lives
    # outside /work so it isn't collected as an artifact. Run with cwd=/work.
    if language == "python":
        suffix, interp = ".py", "python3"
    elif language == "bash":
        suffix, interp = ".sh", "bash"
    else:
        fail(f"sandbox-agent: unsupported language {language!r}")
    fd, script = tempfile.mkstemp(prefix="sandbox_main_", suffix=suffix)
    with os.fdopen(fd, "w") as fh:
        fh.write(code)
    argv = [interp, script]

    started = time.monotonic()
    timed_out = False
    try:
        proc = subprocess.run(
            argv,
            cwd=WORK,
            # HOME on the writable workdir so tools that need a profile dir
            # (LibreOffice, matplotlib, etc.) work under the read-only rootfs.
            # WORK is unique per job, so concurrent jobs don't share a profile.
            env={**os.environ, "HOME": WORK},
            stdin=subprocess.DEVNULL,
            capture_output=True,
            timeout=timeout,
        )
        exit_code = proc.returncode
        out = proc.stdout
        errb = proc.stderr
    except subprocess.TimeoutExpired as e:
        timed_out = True
        exit_code = -1
        out = e.stdout or b""
        errb = e.stderr or b""
    duration_ms = int((time.monotonic() - started) * 1000)
    try:
        os.remove(script)
    except OSError:
        # Best-effort cleanup: the temp script may already be gone; nothing to do.
        pass

    truncated = False
    stdout = out.decode("utf-8", "replace")
    stderr = errb.decode("utf-8", "replace")
    if len(stdout) > MAX_STREAM:
        stdout = stdout[:MAX_STREAM]
        truncated = True
    if len(stderr) > MAX_STREAM:
        stderr = stderr[:MAX_STREAM]
        truncated = True
    if timed_out:
        stderr += f"\nsandbox-agent: timed out after {timeout}s"

    # Preserve the FULL stream as a downloadable artifact when it's large, so
    # the head+tail truncation applied on the way to the model never loses
    # data. Overwrite any prior stdout.txt/stderr.txt (a reused container may
    # carry one from an earlier call in the turn) so we never deliver a stale
    # stream — the delta collection below then treats the rewrite as produced.
    for full_bytes, fname in ((out, "stdout.txt"), (errb, "stderr.txt")):
        fpath = os.path.join(WORK, fname)
        if len(full_bytes) > PRESERVE_THRESHOLD:
            with open(fpath, "wb") as fh:
                fh.write(full_bytes)

    # Collect produced files: anything under /work that isn't an input and that
    # THIS call created or modified (i.e. changed vs the pre-run snapshot).
    # The snapshot diff is what keeps a reused container from re-delivering
    # earlier calls' outputs; on a fresh container everything is new, so this
    # is the same set as before.
    #
    # Materialized before the loop because the INPLACE branch creates hard links
    # at the root as it goes, and those must not be picked up as output of this
    # same call.
    produced = list(walk_files(WORK))
    artifacts = []
    artifacts_truncated = False
    # Seeded with the input names so a flattened subdirectory file can never
    # shadow a file the caller staged.
    used_names = set(inputs)
    for rel, path, st in produced:
        if rel in inputs:
            continue
        if baseline.get(rel) == (st.st_size, st.st_mtime_ns):
            continue  # pre-existing and untouched by this call — not its output
        size = st.st_size
        # An empty file is never interesting; the size cap only applies when we
        # are the ones carrying the bytes.
        if size == 0 or (not INPLACE_ARTIFACTS and size > MAX_ARTIFACT):
            continue
        if len(artifacts) >= MAX_ARTIFACTS:
            artifacts_truncated = True
            break
        name = flat_name(rel, used_names)
        if INPLACE_ARTIFACTS:
            content = ""
            if name != rel and not link_flat(path, name):
                continue
        else:
            with open(path, "rb") as fh:
                content = base64.b64encode(fh.read()).decode("ascii")
        entry = {
            "name": name,
            "size": size,
            "mime": mime_for(rel),
            "content_b64": content,
        }
        if name != rel:
            entry["path"] = rel
        artifacts.append(entry)

    emit(
        {
            "exit_code": exit_code,
            "stdout": stdout,
            "stderr": stderr,
            "artifacts": artifacts,
            "duration_ms": duration_ms,
            "timed_out": timed_out,
            "output_truncated": truncated,
            "artifacts_truncated": artifacts_truncated,
        }
    )


if __name__ == "__main__":
    main()
